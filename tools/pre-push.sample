#!/bin/sh
# Pre-push hook: esegue il checker e scrive check_language_report.txt
# PRIMA di contattare GitHub. Se ci sono errori, il push viene bloccato in locale.
# Se i controlli sono OK, genera i file .lng in MSG/ (CSV → LNG).
#
# Installazione (da root repo, una sola volta):
#   Windows PowerShell:
#     Copy-Item tools\pre-push.sample .git\hooks\pre-push -Force
#   Git Bash:
#     cp tools/pre-push.sample .git/hooks/pre-push && chmod +x .git/hooks/pre-push

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

echo "[pre-push] Eseguo check tabelle MES_LARHEA + CSV MSG/..."
echo "[pre-push] Report: $ROOT/check_language_report.txt"

# Non usiamo set -e: vogliamo comunque lasciare il report anche in caso di FAIL
# check_language_arrays.py richiama anche tools/check_msg_csv.py
python tools/check_language_arrays.py
status=$?

if [ "$status" -ne 0 ]; then
  echo ""
  echo "[pre-push] PUSH BLOCCATO: apri check_language_report.txt per i dettagli."
  exit "$status"
fi

# Controlli OK → conversione CSV lingua → .lng in MSG/ (logica MultiLanguage Tool)
echo "[pre-push] Controlli OK: converto CSV → LNG in MSG/..."
python tools/convert_csv_to_lng.py
conv_status=$?
if [ "$conv_status" -ne 0 ]; then
  echo "[pre-push] PUSH BLOCCATO: conversione CSV→LNG fallita."
  exit "$conv_status"
fi

# Se i .lng sono cambiati rispetto all'indice, avvisa: vanno commitati e ripushati.
# Contesto: il push corrente non li include se non erano già nel commit.
if ! git diff --quiet -- MSG/*.lng 2>/dev/null \
   || [ -n "$(git ls-files --others --exclude-standard -- 'MSG/*.lng')" ]; then
  echo ""
  echo "[pre-push] ATTENZIONE: i file .lng in MSG/ sono stati (ri)generati."
  echo "[pre-push] Aggiungili al commit (git add MSG/*.lng && git commit) e riprova il push."
  echo "[pre-push] PUSH BLOCCATO finché i .lng non sono allineati nel commit."
  exit 1
fi

echo "[pre-push] OK (check + .lng allineati)"
exit 0
